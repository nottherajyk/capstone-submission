# FlyRank Warehouse & Hugging Face Access Configuration
# Copy this file to .env locally and populate your actual token:
#   cp .env.example .env
# IMPORTANT: Never commit your actual .env file or real HF_TOKEN to version control!

HF_TOKEN=hf_your_token_here
FLYRANK_DATA_PATH=data/raw/content_refresh_anonymized.csv
FLYRANK_ENVIRONMENT=development
RANDOM_SEED=42
